{
  "manifest_version": 3,
  "name": "UaiSelect - AI UI Inspector & Prompt Generator",
  "version": "1.0.2",
  "description": "Selecciona cualquier elemento en tu web, detecta su archivo fuente en React/Vue/Vite, copia clases Tailwind y genera prompts estructurados para IA.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "UaiSelect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://mail.google.com/*",
        "https://calendar.google.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["mainWorld.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://mail.google.com/*",
        "https://calendar.google.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mainWorld.js", "logo.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Activar o desactivar el selector visual de UaiSelect"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
